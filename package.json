{
  "name": "file-hub",
  "version": "1.0.0",
  "description": "フォルダ内のOffice/コードファイルを確認・編集できるデスクトップアプリ",
  "main": "./out/main/index.js",
  "author": "File Hub",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "node scripts/copy-pdfjs-assets.mjs && npm run typecheck && electron-vite build",
    "postinstall": "install-electron && node scripts/copy-pdfjs-assets.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "docx": "^9.15.4",
    "docx-preview": "^0.4.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "node-pty": "^1.1.0",
    "pptx-preview": "^1.0.7",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.73.0",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "productName": "File Hub"
}
